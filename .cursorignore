.env.*
!.env.example
!.env.template
!.env.sample
.envrc
*.env
.dev.vars
.secrets/
secrets.*
*.secret
*.secrets
credentials*.json
service-account*.json
client_secret*.json
token.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa*
id_ed25519*
*.kdbx
.npmrc
.pypirc
.netrc
*.tfvars
*.tfvars.json
*.auto.tfvars
terraform.tfstate*
.terraform/
.vercel/
.cursor/mcp.json
.vscode/mcp.json
local.settings.json
*.log

# Live probe output and captured events may hold conversation content.
artifacts/
samples/
