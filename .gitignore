.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
tfplan
*.tfplan

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Lambda build output
build/
*.zip
