# AVA Observability - environment configuration
#
# Copy to .env.local for local development, or set these in the Vercel project settings.
# Variables marked REQUIRED must be present or the app will report itself incomplete at /api/health
# and the dashboard will show a setup screen instead of data.
#
# Note on the interactive OAuth client: it is deliberately NOT configured here. Users enter their
# own Genesys region and Client ID on the sign-in page, so the app never holds credentials that
# grant access to org data on someone else's behalf. Only the background ingestion below has a
# stored identity.


# =============================================================================================
# App session                                                                          REQUIRED
# =============================================================================================

# Signs the app session cookie (HMAC-SHA-256) and encrypts the Genesys tokens held in the
# browser's cookie (AES-256-GCM). Rotating this invalidates every active session.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SESSION_SECRET=

# How long a signed-in session lasts before the user must re-authenticate.        OPTIONAL (720)
SESSION_TTL_MINUTES=720


# =============================================================================================
# Ingestion identity                                                                  REQUIRED
# =============================================================================================

# A Client Credentials OAuth client, used ONLY by the cron routes.
#
# It is separate from the interactive PKCE sign-in on purpose: cron has no cookie jar, and an
# org-wide archive that depended on one person's session would break the day their token was
# revoked.
#
# Grant type: Client Credentials
# Role must grant:
#   architect:flow:view                   list flows and read the agenticVirtualAgentEnabled flag
#   architect:flowExecution:view          submit and read execution-history jobs
#   analytics:botFlowReportingTurn:view   bot flow sessions and reporting turns
GENESYS_INGEST_CLIENT_ID=
GENESYS_INGEST_CLIENT_SECRET=

# The Genesys region domain. Accepts a bare domain, or an api./login. prefixed host, or a full
# https URL - all are normalised to the API host.
#   mypurecloud.de    Frankfurt        mypurecloud.com    US East
#   mypurecloud.ie    Dublin           mypurecloud.com.au Sydney
GENESYS_REGION=mypurecloud.de


# =============================================================================================
# Cron authorisation                                                                  REQUIRED
# =============================================================================================

# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`, and the ingestion routes compare
# it in constant time. It is the only thing between the public internet and the org's entire
# Genesys API budget, so make it long and random - generate it the same way as the session secret.
CRON_SECRET=


# =============================================================================================
# Database                                                                            REQUIRED
# =============================================================================================

# Provided automatically once a Vercel Postgres store is attached to the project. Locally, either
# paste a connection string or run `vercel env pull .env.local`.
#
# Apply the schema once with: npm run db:init
POSTGRES_URL=


# =============================================================================================
# Ingestion tuning                                                                    OPTIONAL
# =============================================================================================

# Comma- or space-separated flow ids to pin ingestion to specific flows.
#
# Leave EMPTY to ingest every flow whose agenticVirtualAgentEnabled flag is set, refreshed by the
# registry pass every six hours. That is the recommended setting: the flag was observed changing
# within a single day as flows were published, so a hand-maintained list silently stops covering
# flows that became AVA-enabled after deployment.
AVA_FLOW_IDS=

# How far back each ingestion pass looks.
#
# Deliberately longer than the 10-minute cron cadence. Reporting-turn data appears with some lag,
# and a window that exactly matched the schedule would permanently lose whatever landed a second
# late. Every write is an upsert, so the overlap costs nothing but a little duplicate work.
INGEST_LOOKBACK_MINUTES=30

# Ceiling on how many conversations one fidelity pass will resolve, so a backlog drains steadily
# rather than in one run that exhausts the function timeout.
INGEST_MAX_EXECUTIONS_PER_RUN=200

# The measured Jobs API acceptance ceiling: 10 execution ids are accepted, 11 are rejected with a
# bare 422. A job costs the same 2 API calls whether it carries 1 id or 10, so this value IS the
# API efficiency - at 10 retrieval costs 0.2 calls per execution, at 1 it costs 2.
#
# Raising it above 10 does not increase throughput; it just forces the bisect path and costs more.
JOBS_MAX_IDS=10


# =============================================================================================
# Presentation                                                                        OPTIONAL
# =============================================================================================

# Shown in the sidebar. Setting this to `production` also forces Secure on all cookies, which is
# what you want on any deployment reached over https.
NEXT_PUBLIC_ENVIRONMENT_LABEL=local
NEXT_PUBLIC_APP_VERSION=0.1.0
