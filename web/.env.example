# AVA Observability — environment configuration
#
# Genesys data access is performed with the signed-in user's Authorization Code + PKCE token.
# There is no client-credentials ingestion identity, cron secret, or polling schedule.


# =============================================================================================
# App session                                                                          REQUIRED
# =============================================================================================

# Signs the app session cookie and encrypts the user's Genesys tokens.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SESSION_SECRET=

# Session lifetime in minutes.                                                   OPTIONAL (720)
SESSION_TTL_MINUTES=720


# =============================================================================================
# Database                                                                             REQUIRED
# =============================================================================================

# Provided when a Postgres store is attached. Apply the schema with: npm run db:init
POSTGRES_URL=


# =============================================================================================
# Capture tuning                                                                       OPTIONAL
# =============================================================================================

# Optional default shown on the sign-in page. Users can always choose another region.
GENESYS_REGION=mypurecloud.de

# Measured Jobs API ceiling. Ten IDs are accepted; eleven return 422.
# Keep this at 10 to reach the 0.2 Platform API call-per-execution floor on full batches.
JOBS_MAX_IDS=10


# =============================================================================================
# Presentation                                                                         OPTIONAL
# =============================================================================================

NEXT_PUBLIC_ENVIRONMENT_LABEL=local
NEXT_PUBLIC_APP_VERSION=0.1.0
