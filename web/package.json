{
  "name": "gc-ava-observability",
  "version": "0.1.0",
  "private": true,
  "description": "AVA explainability and observability dashboards for Genesys Cloud, ingesting on Vercel cron with a measured API budget.",
  "type": "module",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:init": "node scripts/init-db.mjs",
    "db:diagnose": "node scripts/diagnose-turns.mjs",
    "probe:execution": "node scripts/probe-execution.mjs",
    "check": "npm run format:check && npm run lint:strict && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@vercel/postgres": "^0.10.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
